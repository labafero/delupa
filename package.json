{
  "name": "delupa-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:web": "pnpm --filter @delupa/web dev",
    "dev:admin": "pnpm --filter @delupa/admin dev",
    "lint": "pnpm --recursive --if-present lint",
    "format": "prettier --write \"**/*.{vue,ts,js,mjs,cjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{vue,ts,js,mjs,cjs,json,css,yml,yaml}\"",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --workspace-concurrency=1 --recursive --if-present build",
    "supabase:start": "supabase start",
    "supabase:env": "node scripts/write-local-env.mjs",
    "supabase:stop": "supabase stop --no-backup"
  },
  "devDependencies": {
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "supabase": "catalog:"
  }
}
